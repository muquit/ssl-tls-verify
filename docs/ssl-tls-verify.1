.SS How to use ssl\-tls\-verify as a library
\f[CR]ssl\-tls\-verify\f[R] can be used a libary with other projects.
Some examples are shown below
.SS Cert checker
.SS Create a project directory
.IP
.EX
mkdir cert_checker
cd cert_checker
.EE
.SS Create \f[CR]main.go\f[R]
.IP
.EX
\f[B]package\f[R] main

\f[I]// Example of using ssl\-tls\-verify as a library\f[R]
\f[I]// requires ssl\-tls\-verify v1.0.3+\f[R]
\f[I]// Oct\-05\-2025 \f[R]
\f[B]import\f[R] (
    \(dqfmt\(dq
    \(dqtime\(dq

    \(dqgithub.com/muquit/ssl\-tls\-verify/pkg/connection\(dq
)

\f[B]func\f[R] main() {
    hosts := []string{\(dqgoogle.com\(dq, \(dqgithub.com\(dq, \(dqstackoverflow.com\(dq}

    \f[B]for\f[R] _, host := \f[B]range\f[R] hosts {
        config := connection.TLSConfig{
            Host:           host,
            Port:           \(dq443\(dq,
            SkipVerify:     false,
            ConnectTimeout: 5 * time.Second,
        }

        certs, _, err := connection.TestDirectTLS(config)
        \f[B]if\f[R] err != nil {
            fmt.Printf(\(dqERROR: %s \- Failed: %v\(rsn\(dq, host, err)
            \f[B]continue\f[R]
        }

        leafCert := certs[0]
        daysUntilExpiry := int(time.Until(leafCert.NotAfter).Hours() / 24)

        \f[B]if\f[R] daysUntilExpiry < 30 {
            fmt.Printf(\(dqWARING: %s \- Expires in %d days\(rsn\(dq, host, daysUntilExpiry)
        } \f[B]else\f[R] {
            fmt.Printf(\(dqOK: %s \- Valid for %d days\(rsn\(dq, host, daysUntilExpiry)
        }
    }
}
.EE
.SS Initialize go module
.IP
.EX
go mod init cert_checker
go mod tidy
.EE
.SS Build
.IP
.EX
go build .
.EE
.SS Run
.IP
.EX
\&./cert_checker
.EE
.IP
.EX
OK: google.com \- Valid for 63 days
OK: github.com \- Valid for 123 days
