.EE
.SS TLS checker
.SS Create a project directory
.IP
.EX
mkdir tls_checker
cd tls_checker
.EE
.SS Create \f[CR]main.go\f[R]
.IP
.EX
\f[B]package\f[R] main

\f[I]// Check TLS connection\f[R]
\f[B]import\f[R] (
    \(dqfmt\(dq
    \(dqlog\(dq
    \(dqtime\(dq

    \(dqgithub.com/muquit/ssl\-tls\-verify/pkg/connection\(dq
)

\f[B]func\f[R] main() {
    config := connection.TLSConfig{
        Host:           \(dqgoogle.com\(dq,
        Port:           \(dq443\(dq,
        SkipVerify:     false,
        ConnectTimeout: 10 * time.Second,
    }

    certs, state, err := connection.TestDirectTLS(config)
    \f[B]if\f[R] err != nil {
        log.Fatalf(\(dqConnection failed: %v\(dq, err)
    }

    fmt.Printf(\(dqConnected successfully!\(rsn\(dq)
    fmt.Printf(\(dqTLS Version: 0x%04x\(rsn\(dq, state.Version)
    fmt.Printf(\(dqRetrieved %d certificate(s)\(rsn\(dq, len(certs))

    connection.PrintTLSInfo(state)
}
