\f[B]package\f[R] main

\f[B]import\f[R] (
    \(dqlog\(dq
    \(dqtime\(dq

    \(dqgithub.com/muquit/ssl\-tls\-verify/pkg/certificate\(dq
    \(dqgithub.com/muquit/ssl\-tls\-verify/pkg/connection\(dq
)

\f[B]func\f[R] main() {
    \f[I]// Get certificates from a connection\f[R]
    config := connection.TLSConfig{
        Host:           \(dqexample.com\(dq,
        Port:           \(dq443\(dq,
        SkipVerify:     false,
        ConnectTimeout: 10 * time.Second,
    }

    certs, _, err := connection.TestDirectTLS(config)
    \f[B]if\f[R] err != nil {
        log.Fatalf(\(dqConnection failed: %v\(dq, err)
    }

    \f[I]// Save as PEM\f[R]
    err = certificate.Save(certs, certificate.SaveConfig{
        Format:     \(dqpem\(dq,
        OutputFile: \(dqcertificates.pem\(dq,
    })
    \f[B]if\f[R] err != nil {
        log.Fatalf(\(dqFailed to save PEM: %v\(dq, err)
    }

    \f[I]// Save as DER (leaf certificate only)\f[R]
    err = certificate.Save(certs, certificate.SaveConfig{
        Format:     \(dqder\(dq,
        OutputFile: \(dqcertificate.der\(dq,
    })
    \f[B]if\f[R] err != nil {
        log.Fatalf(\(dqFailed to save DER: %v\(dq, err)
    }

    \f[I]// Save as human\-readable text\f[R]
    err = certificate.Save(certs, certificate.SaveConfig{
        Format:     \(dqtext\(dq,
        OutputFile: \(dqcertificate\-details.txt\(dq,
    })
    \f[B]if\f[R] err != nil {
        log.Fatalf(\(dqFailed to save text: %v\(dq, err)
    }
}
