\f[B]package\f[R] main

\f[I]// StartTLS checker\f[R]

\f[B]import\f[R] (
    \(dqfmt\(dq
    \(dqlog\(dq
    \(dqtime\(dq

    \(dqgithub.com/muquit/ssl\-tls\-verify/pkg/connection\(dq
)

\f[B]func\f[R] main() {
    config := connection.StartTLSConfig{
        Host:           \(dqsmtp.gmail.com\(dq,
        Port:           \(dq587\(dq,
        SkipVerify:     false,
        ConnectTimeout: 10 * time.Second,
    }

    certs, state, err := connection.TestStartTLS(config)
