.SS Generate certificate fingerprints
.SS Create a project directory
.IP
.EX
mkdir gen_fingerprint
cd gen_fingerprint
.EE
.SS Create \f[CR]main.go\f[R]
.IP
.EX
\f[B]package\f[R] main

\f[B]import\f[R] (
    \(dqfmt\(dq
    \(dqlog\(dq
    \(dqtime\(dq

    \(dqgithub.com/muquit/ssl\-tls\-verify/pkg/certificate\(dq
    \(dqgithub.com/muquit/ssl\-tls\-verify/pkg/connection\(dq
)

\f[B]func\f[R] main() {
    config := connection.TLSConfig{
        Host:           \(dqgoogle.com\(dq,
        Port:           \(dq443\(dq,
        SkipVerify:     false,
        ConnectTimeout: 10 * time.Second,
    }

    certs, _, err := connection.TestDirectTLS(config)
    \f[B]if\f[R] err != nil {
        log.Fatalf(\(dqConnection failed: %v\(dq, err)
    }

    \f[I]// Get fingerprints for the leaf certificate\f[R]
    leafCert := certs[0]

    sha1FP := certificate.FormatFingerprint(leafCert.Raw, \(dqsha1\(dq)
    sha256FP := certificate.FormatFingerprint(leafCert.Raw, \(dqsha256\(dq)

    fmt.Printf(\(dqSHA\-1 Fingerprint:   %s\(rsn\(dq, sha1FP)
    fmt.Printf(\(dqSHA\-256 Fingerprint: %s\(rsn\(dq, sha256FP)
}
